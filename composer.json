{
    "name": "karo_ej/php-notes-platform",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "Core/",
             "Tests\\": "tests/"
        },
        "files": [
            "core/functions.php"
        ]
    },
    "authors": [
        {
            "name": "g-i-kala",
            "email": "5star@wp.pl"
        }
    ],
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/collections": "^12.10"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "rector/rector": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
    "check": [
        "@pest",
        "@phpstan",
        "@rector:dry"
    ],
    "pest": "vendor/bin/pest",
    "rector:dry": "vendor/bin/rector process --dry-run",
    "phpstan": "vendor/bin/phpstan analyse"
}
}
